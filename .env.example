# Copy this file to .env and fill in the paths for your system.
# .env is loaded automatically at runtime via python-dotenv.

# Root directory of the repository (absolute path)
PROJECT_ROOT=/path/to/symmbfn

# Directory where Hydra writes run outputs and multiruns
HYDRA_JOBS=/path/to/hydra/outputs

# Directory where Weights & Biases stores its local files
WABDB_DIR=/path/to/wandb
