# General
# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
wheelhouse/

# Virtual environments
venv/
env/
.venv/
ENV/
envs/
.conda/
conda-meta/

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# macOS / Windows
.DS_Store
Thumbs.db

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Type checkers / compiled artifacts
.mypy_cache/
cython_debug/

# Jupyter
.ipynb_checkpoints

# Logs and runtime
logs/
*.log

# Model artifacts / checkpoints
models/
checkpoints/
saved_models/
*.pt
*.pth
*.ckpt
!data/**/dist.pt

# ML tooling
wandb/
mlruns/
results/
outputs/
experiments/
tensorboard/
tb_logs/

# Secrets and environment
.env
credentials/
secrets.yml
*.pem
*.key

# Misc
*.egg
*.spec
*.so
coverage.xml
*.swp
*.swo
